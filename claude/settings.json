      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:www.rfc-editor.org)",
      "WebFetch(domain:opentofu.org)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:golangci-lint.run)",
      "WebFetch(domain:staticcheck.dev)",
      "WebFetch(domain:staticcheck.io)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:docs.sqlc.dev)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:biomejs.dev)",
