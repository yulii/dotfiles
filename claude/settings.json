      "Bash(git reset *--keep*)",
      "Bash(git rm -f*)",
      "Bash(git rm * -f*)",
      "Bash(git rm --force*)",
      "Bash(git rm * --force*)",
      "Bash(git rm -rf*)",
      "Bash(git rm * -rf*)",
      "Bash(git rm -qf*)",
      "Bash(git rm * -qf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(jq -r '.tool_input.command // \"\"'); printf '%s' \"$c\" | grep -Eq 'git[[:space:]]+commit' || exit 0; command -v git-secrets >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 || exit 0; git secrets --scan --cached >/dev/null 2>&1 && exit 0; echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"staged の内容が git-secrets のパターンに一致した。回避せずに止まり、git secrets --scan --cached の結果をユーザーに報告する。.gitallowed は自分で編集しない。\"}}'; exit 0",
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-branch-delete.sh",
            "if": "Bash(git *)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-push.sh",
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-excluded-chain.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "c=$(jq -r '.tool_input.command // \"\"'); printf '%s\\n' \"$c\" | tr ';|&' '\\n' | while IFS= read -r l; do l=\" $l\"; printf '%s' \"$l\" | grep -Eq '[[:space:]]gh[[:space:]]+api([[:space:]]|$)' || continue; m=$(printf '%s' \"$l\" | grep -Eo '[[:space:]](-X|--method)(=|[[:space:]]*)[A-Za-z]+' | sed -nE '$s/.*(-X|--method)(=|[[:space:]]*)//p' | tr '[:lower:]' '[:upper:]'); if [ -n \"$m\" ]; then [ \"$m\" = GET ] && continue; else printf '%s' \"$l\" | grep -Eq '[[:space:]](-[fF]|--field|--raw-field|--input)' || continue; fi; echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"GitHub に書き込む gh api。-X GET 以外のメソッドか、-X GET なしの -f・-F・--input は POST になる。\"}}'; break; done; exit 0",
            "if": "Bash(gh *)",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-permission-request.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "uploads.github.com",
        "results-receiver.actions.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.docker/config.json"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git pull *",
      "git merge *",
      "git switch *",
      "git checkout -b *",
      "git rebase *",
      "git stash *",
      "git cherry-pick *",
      "git reset *",
      "git branch *",
      "git remote *",
      "gh pr checkout *",
      "gh repo sync *",
      "gh repo set-default *"
    ]
  },
  "autoMemoryEnabled": false,
  "agentPushNotifEnabled": true,
  "theme": "dark"
}
