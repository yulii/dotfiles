      "Bash(git stash push *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git stash pop *)",
      "Bash(git stash apply *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(sleep *)",
      "Bash(seq *)",
      "Bash(jq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(column *)",
      "Bash(paste *)",
      "Bash(comm *)",
      "Bash(sort *)",
      "Bash(base64 *)",
      "Bash(uniq)",
      "Bash(uniq -c)",
      "Bash(uniq -d)",
      "Bash(uniq -u)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh api *)",
      "Bash(make *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(git checkout)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout * --force*)",
      "Bash(git checkout --discard-changes*)",
      "Bash(git checkout * --discard-changes*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
