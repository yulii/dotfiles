{
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "uploads.github.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(done)",
      "Bash(git checkout:*)",
      "Bash(gh pr:*)",
      "Bash(make:*)",
      "Bash(docker:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Bash(docker -H*)",
      "Bash(docker --host*)",
      "Bash(docker context use:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(jq -r '.tool_input.command // \"\"'); printf '%s' \"$c\" | grep -Eq 'git[[:space:]]+push' && printf '%s' \"$c\" | grep -Eq '(^|[[:space:]])(-f|--force|--force-with-lease|--force-if-includes)([=[:space:]]|$)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"git push の force 系オプションは禁止。リモートを巻き戻すおそれがあるため、必要なら人が手で実行する。\"}}'; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
